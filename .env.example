# Database (SQLite, no config needed for local dev)
DATABASE_URL="file:./kimondo.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay (leave empty for stub/test mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Shiprocket (leave empty for stub mode)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Resend (leave empty for console logging)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Kimondo <noreply@kimondo.in>"
