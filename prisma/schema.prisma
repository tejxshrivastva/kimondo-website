generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── AUTH & USER ─────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  image         String?
  role          String    @default("customer")
  memberSince   DateTime  @default(now())
  emailVerified DateTime?
  defaultPincode String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  addresses      Address[]
  savedSizes     SavedSize[]
  cartLines      CartLine[]
  orders         Order[]
  badgeAwards    BadgeAward[]
  notifyRequests NotifyRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── ADDRESSES & SAVED SIZES ─────────────────────────

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedSize {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Mine")
  isSelf     Boolean @default(true)
  topSize    String?
  bottomSize String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── PRODUCT CATALOG ─────────────────────────────────

model Set {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  tagline          String?
  description      String?
  productDetails   String?
  careInstructions String?
  coverImage       String   @default("")
  images           String   @default("[]")
  toneFrom         String   @default("#d4d4d4")
  toneTo           String   @default("#a3a3a3")
  status           String   @default("draft")
  campaignId       String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaign  Campaign? @relation(fields: [campaignId], references: [id])
  items     Item[]
  badge     Badge?
  cartLines CartLine[]
}

model Item {
  id        String @id @default(cuid())
  setId     String
  name      String
  category  String
  price     Int
  image     String?
  sortOrder Int    @default(0)

  set      Set       @relation(fields: [setId], references: [id], onDelete: Cascade)
  variants Variant[]
}

model Variant {
  id     String @id @default(cuid())
  itemId String
  size   String
  sku    String @unique
  stock  Int    @default(0)

  item           Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cartLines      CartLine[]
  orderLines     OrderLine[]
  notifyRequests NotifyRequest[]
}

model Campaign {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  subtitle    String?
  heroImage   String?
  body        String?
  credits     String    @default("[]")
  location    String?
  date        String?
  status      String    @default("draft")
  publishedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sets Set[]
}

model Faq {
  id        String @id @default(cuid())
  question  String
  answer    String
  section   String @default("general")
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── CART & ORDERS ───────────────────────────────────

model CartLine {
  id        String @id @default(cuid())
  userId    String
  setId     String
  variantId String
  quantity  Int    @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  set     Set     @relation(fields: [setId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

model Order {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  userId            String
  addressSnapshot   String
  contactName       String
  contactPhone      String
  contactEmail      String
  status            String   @default("pending")
  totalMinor        Int
  paymentMethod     String?
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  shiprocketOrderId String?
  shiprocketAWB     String?
  trackingUrl       String?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  orderLines     OrderLine[]
  returnRequests ReturnRequest[]
  badgeAwards    BadgeAward[]
}

model OrderLine {
  id             String @id @default(cuid())
  orderId        String
  variantId      String
  setName        String
  itemName       String
  size           String
  category       String
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  lineIds   String
  reason    String?
  status    String   @default("requested")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ── BADGES ──────────────────────────────────────────

model Badge {
  id      String  @id @default(cuid())
  name    String
  setId   String  @unique
  artwork String?

  set    Set          @relation(fields: [setId], references: [id])
  awards BadgeAward[]
}

model BadgeAward {
  id           String    @id @default(cuid())
  userId       String
  badgeId      String
  orderId      String
  state        String    @default("pending")
  grantedAt    DateTime  @default(now())
  solidifiesAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@unique([userId, badgeId])
}

// ── NOTIFICATIONS ───────────────────────────────────

model NotifyRequest {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
}

// ── SITE CONFIGURATION ──────────────────────────────

model HomepageSetting {
  id              String @id @default(cuid())
  heroTitle       String @default("")
  heroSubtitle    String @default("")
  heroImage       String?
  heroImageMobile String?
  heroVideo       String?
  ctaLabel        String @default("Shop now")
  ctaTarget       String @default("/store")
  featuredSetIds  String @default("[]")
  updatedAt       DateTime @updatedAt
}

model Policy {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id                    String @id @default(cuid())
  returnWindowDays      Int    @default(7)
  exchangeWindowDays    Int    @default(14)
  founderEmail          String @default("")
  founderPageTitle      String @default("")
  founderPageSubtitle   String @default("")
  socialLinks           String @default("[]")
  updatedAt             DateTime @updatedAt
}
